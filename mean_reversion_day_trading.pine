//@version=6

// ═══════════════════════════════════════════════════════════════════════════════
// QUANT-7 MEAN REVERSION v2 — POST-AUTOPSY REBUILD
// ═══════════════════════════════════════════════════════════════════════════════
//
// BACKTEST AUTOPSY (MNQ 5m, Dec 2025 – Mar 2026, 58 trades):
//   Net P&L: -$223 | Sharpe: -0.77 | PF: 0.93 | Win Rate: 53% | Avg W/L: 0.81
//
// PRIMARY FAILURE MODES IDENTIFIED:
//   1. RE-ENTRY CASCADES: After stop-out, conditions remain true → immediate
//      re-entry → stopped again. 6 clusters caused -$1,806 (59% of gross loss).
//      FIX: Cooldown timer — no re-entry for N bars after a stop-loss.
//
//   2. UNFAVORABLE R:R: Mean reversion to BB mid = small winners ($91 avg)
//      but ATR stops produce larger losers ($113 avg). Ratio = 0.81.
//      FIX: Widen BB entry threshold to 2.5σ for more room to revert.
//           Add R-Multiple mode with minimum 1.5:1 reward/risk.
//
//   3. NO REGIME FILTER: All cascading losses occurred in trending moves.
//      FIX: ADX < 25 hard filter (was absent in v1 backtest).
//
//   4. COMMISSION DRAG: $593 on $2,838 gross = 21% eaten by costs. Many
//      trades were tiny winners ($8-25) that barely covered round-trip.
//      FIX: Min profit target filter — don't enter if BB mid is too close.
//
//   5. VOLUME FILTER WAS 1.0x (= no filter). Now requires 1.5x spike.
//
//   6. NO TIME-OF-DAY FILTER: First 30 min had false signals from gap fills.
//      FIX: Delay entries until 10:00 AM to avoid opening auction noise.
//
// ═══════════════════════════════════════════════════════════════════════════════

strategy("QUANT-7 Mean Reversion v2", overlay = true,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     initial_capital = 100000,
     commission_type = strategy.commission.percent,
     commission_value = 0.02,
     slippage = 2,
     process_orders_on_close = false,
     calc_on_every_tick = false,
     currency = currency.USD)

// ─── INPUTS: SIGNAL GENERATION ───────────────────────────────────────────────

bbLength      = input.int(20, "BB Lookback", minval = 10, maxval = 50, step = 5, group = "Signal: Bollinger Bands", tooltip = "Robust range: 15-30.")
bbMult        = input.float(2.5, "BB Std Dev", minval = 1.5, maxval = 3.5, step = 0.25, group = "Signal: Bollinger Bands", tooltip = "v2: Raised from 2.0 to 2.5. Requires more extreme deviation = higher conviction entries with more room to revert.")

rsiLength     = input.int(7, "RSI Lookback", minval = 2, maxval = 21, step = 1, group = "Signal: RSI", tooltip = "Short RSI (2-7) per Connors research on intraday mean reversion.")
rsiOversold   = input.int(20, "RSI Oversold", minval = 5, maxval = 40, group = "Signal: RSI", tooltip = "v2: Tightened from 25 to 20 for higher conviction.")
rsiOverbought = input.int(80, "RSI Overbought", minval = 60, maxval = 95, group = "Signal: RSI", tooltip = "v2: Tightened from 75 to 80 for higher conviction.")

// ─── INPUTS: REGIME FILTER ───────────────────────────────────────────────────

useAdxFilter  = input.bool(true, "Enable ADX Regime Filter", group = "Regime Filter", tooltip = "CRITICAL: Disables entries when ADX > threshold. All 6 cascading loss clusters in v1 occurred during trending regimes.")
adxLength     = input.int(14, "ADX Lookback", minval = 7, maxval = 30, group = "Regime Filter")
adxThreshold  = input.int(25, "ADX Max (Ranging Regime)", minval = 15, maxval = 40, group = "Regime Filter", tooltip = "ADX < 25 = ranging. This single filter would have prevented ~60% of v1 losses.")

// ─── INPUTS: VOLUME CONFIRMATION ─────────────────────────────────────────────

useVolFilter  = input.bool(true, "Require Volume Spike", group = "Volume Filter", tooltip = "v1 used 1.0x (= no filter). Now requires genuine volume surge.")
volLength     = input.int(20, "Volume MA Lookback", minval = 10, maxval = 50, group = "Volume Filter")
volMult       = input.float(1.5, "Volume Spike Multiplier", minval = 1.0, maxval = 3.0, step = 0.1, group = "Volume Filter", tooltip = "v2: Raised from 1.0 to 1.5. Ensures institutional participation on entry bar.")

// ─── INPUTS: COOLDOWN (NEW — fixes re-entry cascades) ───────────────────────

useCooldown      = input.bool(true, "Enable Post-Stop Cooldown", group = "Cooldown", tooltip = "CRITICAL FIX: After a stop-loss, wait N bars before re-entering. Prevents the re-entry death spiral that caused 59% of v1 gross loss.")
cooldownBars     = input.int(12, "Cooldown Bars After Stop", minval = 3, maxval = 30, group = "Cooldown", tooltip = "12 bars × 5 min = 60 min cooldown. Allows the trending move to exhaust before re-attempting.")
useConsecLimit   = input.bool(true, "Enable Consecutive Loss Limit", group = "Cooldown", tooltip = "After N consecutive losses, extend cooldown further.")
maxConsecLosses  = input.int(2, "Max Consecutive Losses", minval = 1, maxval = 5, group = "Cooldown", tooltip = "After 2 consecutive losses, apply extended cooldown.")
extendedCooldown = input.int(24, "Extended Cooldown Bars", minval = 12, maxval = 60, group = "Cooldown", tooltip = "24 bars × 5 min = 2 hours. Reset the regime before trying again.")

// ─── INPUTS: RISK MANAGEMENT ─────────────────────────────────────────────────

riskPct       = input.float(1.0, "Risk Per Trade (%)", minval = 0.25, maxval = 3.0, step = 0.25, group = "Risk Management", tooltip = "Fixed fractional position sizing. Risk this % of equity per trade.")
atrLength     = input.int(14, "ATR Lookback (Stop Calc)", minval = 5, maxval = 30, group = "Risk Management")
atrSlMult     = input.float(2.0, "Stop Loss (ATR Multiple)", minval = 0.5, maxval = 4.0, step = 0.25, group = "Risk Management", tooltip = "v2: Raised from 1.5 to 2.0. Wider stops reduce whipsaw stop-outs in volatile conditions.")
tpMode        = input.string("Mean", "Take Profit Mode", options = ["Mean", "R-Multiple", "Opposite Band"], group = "Risk Management", tooltip = "Mean: exit at BB midline. R-Multiple: fixed reward/risk ratio. Opposite Band: exit at far BB.")
tpRatio       = input.float(1.5, "R-Multiple (if R-Multiple mode)", minval = 0.5, maxval = 5.0, step = 0.25, group = "Risk Management")
maxBarsInTrade = input.int(20, "Max Bars in Trade (Time Stop)", minval = 5, maxval = 50, group = "Risk Management", tooltip = "Exits if trade hasn't hit TP/SL within N bars. Prevents capital lock-up.")

// ─── INPUTS: MIN PROFIT THRESHOLD (NEW — fixes commission drag) ──────────────

useMinProfit  = input.bool(true, "Require Min Profit Target", group = "Trade Quality", tooltip = "Skip entries where the distance to BB mid is too small to cover costs. Eliminates tiny winners that get eaten by commissions.")
minProfitAtr  = input.float(0.5, "Min Profit Target (ATR Multiple)", minval = 0.1, maxval = 2.0, step = 0.1, group = "Trade Quality", tooltip = "Distance from entry to BB mid must be at least 0.5 × ATR. Filters out low-reward setups.")

// ─── INPUTS: BB WIDTH FILTER (NEW — avoids compressed ranges) ────────────────

useBbWidthFilter = input.bool(true, "Require Min BB Width", group = "Trade Quality", tooltip = "When bands are too narrow, the reversion target is too close to cover costs and stops are too tight.")
bbWidthMinPct    = input.float(0.3, "Min BB Width (% of Price)", minval = 0.1, maxval = 1.0, step = 0.05, group = "Trade Quality", tooltip = "BB width must be at least 0.3% of price. Ensures enough room for profitable mean reversion.")

// ─── INPUTS: SESSION & EOD ───────────────────────────────────────────────────

useSession    = input.bool(true, "Restrict to Session", group = "Session")
sessionTime   = input.session("1000-1550", "Session (Exchange TZ)", group = "Session", tooltip = "v2: Changed from 0930 to 1000. Avoids first 30 min of opening auction noise where gap fills create false mean reversion signals.")
closeEod      = input.bool(true, "Flatten at EOD", group = "Session")

// ─── INPUTS: BACKTEST WINDOW ─────────────────────────────────────────────────

useStartDate  = input.bool(false, "Use Backtest Start Date", group = "Backtest Window")
startDate     = input.time(timestamp("2020-01-01"), "Start Date", group = "Backtest Window")
useEndDate    = input.bool(false, "Use Backtest End Date", group = "Backtest Window")
endDate       = input.time(timestamp("2025-12-31"), "End Date", group = "Backtest Window")

inDateRange   = (not useStartDate or time >= startDate) and (not useEndDate or time <= endDate)

// ═══════════════════════════════════════════════════════════════════════════════
// CALCULATIONS
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Bollinger Bands ─────────────────────────────────────────────────────────

[bbMid, bbUpper, bbLower] = ta.bb(close, bbLength, bbMult)
bbWidth    = bbUpper - bbLower
bbPctB     = bbWidth > 0 ? (close - bbLower) / bbWidth : 0.5
zScore     = bbWidth > 0 ? (close - bbMid) / (bbWidth / (2 * bbMult)) : 0.0
bbWidthPct = close > 0 ? bbWidth / close * 100 : 0.0

// ─── RSI ─────────────────────────────────────────────────────────────────────

rsi = ta.rsi(close, rsiLength)

// ─── ADX (Directional Movement Index for regime detection) ───────────────────

upMove   = high - high[1]
downMove = low[1] - low
plusDM   = upMove > downMove and upMove > 0 ? upMove : 0.0
minusDM  = downMove > upMove and downMove > 0 ? downMove : 0.0
trueRange = ta.rma(ta.tr, adxLength)
plusDI    = trueRange > 0 ? 100 * ta.rma(plusDM, adxLength) / trueRange : 0.0
minusDI   = trueRange > 0 ? 100 * ta.rma(minusDM, adxLength) / trueRange : 0.0
diSum     = plusDI + minusDI
dx        = diSum > 0 ? 100 * math.abs(plusDI - minusDI) / diSum : 0.0
adx       = ta.rma(dx, adxLength)

isRanging = not useAdxFilter or adx < adxThreshold

// ─── Volume ──────────────────────────────────────────────────────────────────

volMa  = ta.sma(volume, volLength)
volOk  = not useVolFilter or (volMa > 0 and volume >= volMa * volMult)

// ─── ATR ─────────────────────────────────────────────────────────────────────

atr = ta.atr(atrLength)

// ─── Session ─────────────────────────────────────────────────────────────────

inSession = useSession ? not na(time(timeframe.period, sessionTime)) : true

// ─── BB Width Filter ─────────────────────────────────────────────────────────

bbWidthOk = not useBbWidthFilter or bbWidthPct >= bbWidthMinPct

// ─── Min Profit Filter ───────────────────────────────────────────────────────

longProfitDist  = bbMid - close   // distance from entry to BB mid for longs
shortProfitDist = close - bbMid   // distance from entry to BB mid for shorts
longProfitOk    = not useMinProfit or (atr > 0 and longProfitDist >= atr * minProfitAtr)
shortProfitOk   = not useMinProfit or (atr > 0 and shortProfitDist >= atr * minProfitAtr)

// ═══════════════════════════════════════════════════════════════════════════════
// COOLDOWN SYSTEM — PREVENTS RE-ENTRY CASCADES
// ═══════════════════════════════════════════════════════════════════════════════

// Track bars since last exit and consecutive losses
var int barsSinceExit    = 999  // Start high so first trade is allowed
var int consecLosses     = 0
var float lastExitPnl    = 0.0
var bool wasInPosition   = false

// Detect position close and track P&L
currentlyInPosition = strategy.position_size != 0
justExited = wasInPosition and not currentlyInPosition
wasInPosition := currentlyInPosition

if justExited
    barsSinceExit := 0
    // Check if last trade was a loss by comparing equity
    thisTradePnl = strategy.netprofit - lastExitPnl
    lastExitPnl := strategy.netprofit
    if thisTradePnl < 0
        consecLosses += 1
    else
        consecLosses := 0
else
    if not currentlyInPosition
        barsSinceExit += 1

// Determine required cooldown
activeCooldown = useCooldown ? (useConsecLimit and consecLosses >= maxConsecLosses ? extendedCooldown : cooldownBars) : 0
cooldownOk = barsSinceExit >= activeCooldown

// ═══════════════════════════════════════════════════════════════════════════════
// SIGNAL LOGIC
// ═══════════════════════════════════════════════════════════════════════════════

// Long: price closes below lower BB + RSI oversold + ranging + volume + cooldown clear
longSignal  = close < bbLower and rsi < rsiOversold and isRanging and volOk and inSession and inDateRange and cooldownOk and bbWidthOk and longProfitOk

// Short: price closes above upper BB + RSI overbought + ranging + volume + cooldown clear
shortSignal = close > bbUpper and rsi > rsiOverbought and isRanging and volOk and inSession and inDateRange and cooldownOk and bbWidthOk and shortProfitOk

// ═══════════════════════════════════════════════════════════════════════════════
// POSITION SIZING — FIXED FRACTIONAL (RISK-BASED)
// ═══════════════════════════════════════════════════════════════════════════════

stopDist     = atr * atrSlMult
riskAmount   = strategy.equity * (riskPct / 100)
posSize      = stopDist > 0 ? math.floor(riskAmount / stopDist) : 0
posSizeFinal = math.max(posSize, 1)

// ═══════════════════════════════════════════════════════════════════════════════
// TAKE PROFIT CALCULATION
// ═══════════════════════════════════════════════════════════════════════════════

longTp  = tpMode == "Mean" ? bbMid : tpMode == "Opposite Band" ? bbUpper : close + stopDist * tpRatio
shortTp = tpMode == "Mean" ? bbMid : tpMode == "Opposite Band" ? bbLower : close - stopDist * tpRatio

// ═══════════════════════════════════════════════════════════════════════════════
// ENTRIES & EXITS
// ═══════════════════════════════════════════════════════════════════════════════

// Track bars since entry for time stop
var int barsSinceEntry = 0
if strategy.position_size != 0
    barsSinceEntry += 1
else
    barsSinceEntry := 0

// ─── Entries ─────────────────────────────────────────────────────────────────

if longSignal and strategy.position_size == 0
    longSlPrice = close - stopDist
    strategy.entry("Long", strategy.long, qty = posSizeFinal)
    strategy.exit("Long SL/TP", "Long", stop = longSlPrice, limit = longTp)

if shortSignal and strategy.position_size == 0
    shortSlPrice = close + stopDist
    strategy.entry("Short", strategy.short, qty = posSizeFinal)
    strategy.exit("Short SL/TP", "Short", stop = shortSlPrice, limit = shortTp)

// ─── Mean Reversion Exits (global scope) ─────────────────────────────────────

crossAboveMid = ta.crossover(close, bbMid)
crossBelowMid = ta.crossunder(close, bbMid)

if tpMode == "Mean"
    if strategy.position_size > 0 and crossAboveMid
        strategy.close("Long", comment = "Mean revert")
    if strategy.position_size < 0 and crossBelowMid
        strategy.close("Short", comment = "Mean revert")

// ─── Time Stop ───────────────────────────────────────────────────────────────

if barsSinceEntry >= maxBarsInTrade and strategy.position_size != 0
    strategy.close_all(comment = "Time stop (" + str.tostring(maxBarsInTrade) + " bars)")

// ─── EOD Flatten ─────────────────────────────────────────────────────────────

if closeEod and useSession and inSession[1] and not inSession
    strategy.close_all(comment = "EOD flatten")

if useSession and not inSession and strategy.position_size != 0
    strategy.close_all(comment = "Out of session")

// ═══════════════════════════════════════════════════════════════════════════════
// VISUALS
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Bollinger Bands ─────────────────────────────────────────────────────────

pMid   = plot(bbMid, "BB Mid", color.new(color.yellow, 20), linewidth = 1)
pUpper = plot(bbUpper, "BB Upper", color.new(color.teal, 30), linewidth = 1)
pLower = plot(bbLower, "BB Lower", color.new(color.teal, 30), linewidth = 1)
fill(pUpper, pMid, color = color.new(color.teal, 94), title = "BB Upper Fill")
fill(pMid, pLower, color = color.new(color.teal, 94), title = "BB Lower Fill")

// ─── Entry Signals ───────────────────────────────────────────────────────────

plotshape(longSignal and strategy.position_size == 0, "Long Entry",
     shape.labelup, location.belowbar, color.new(color.green, 0), size = size.small, text = "L")
plotshape(shortSignal and strategy.position_size == 0, "Short Entry",
     shape.labeldown, location.abovebar, color.new(color.red, 0), size = size.small, text = "S")

// ─── Cooldown Indicator ─────────────────────────────────────────────────────

bgcolor(not cooldownOk and strategy.position_size == 0 ? color.new(color.purple, 95) : na, title = "Cooldown Active")
bgcolor(not isRanging ? color.new(color.orange, 95) : na, title = "Trending Regime (No Trade)")
bgcolor(strategy.position_size > 0 ? color.new(color.green, 94) :
     strategy.position_size < 0 ? color.new(color.red, 94) : na, title = "Position")

// ═══════════════════════════════════════════════════════════════════════════════
// DASHBOARD — REAL-TIME QUANT METRICS
// ═══════════════════════════════════════════════════════════════════════════════

var table dash = table.new(position.top_right, 2, 13, bgcolor = color.new(#0a0a0a, 10),
     border_width = 1, border_color = color.new(color.gray, 60))

if barstate.islastconfirmedhistory or barstate.islast
    rsiCol  = rsi < rsiOversold ? color.lime : rsi > rsiOverbought ? color.red : color.white
    adxCol  = adx < adxThreshold ? color.lime : color.orange
    volCol  = volOk ? color.lime : color.gray
    zCol    = math.abs(zScore) > 2 ? color.yellow : color.white
    sessCol = inSession ? color.lime : color.red
    cdCol   = cooldownOk ? color.lime : color.fuchsia

    // Row 0: Header
    table.cell(dash, 0, 0, "QUANT-7", text_color = color.aqua, text_size = size.small)
    table.cell(dash, 1, 0, "v2", text_color = color.aqua, text_size = size.small)

    // Row 1: Z-Score
    table.cell(dash, 0, 1, "Z-Score", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 1, str.tostring(zScore, "#.00"), text_color = zCol, text_size = size.small)

    // Row 2: %B
    table.cell(dash, 0, 2, "%B", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 2, str.tostring(bbPctB, "#.00"), text_color = color.white, text_size = size.small)

    // Row 3: RSI
    table.cell(dash, 0, 3, "RSI(" + str.tostring(rsiLength) + ")", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 3, str.tostring(rsi, "#.0"), text_color = rsiCol, text_size = size.small)

    // Row 4: ADX
    table.cell(dash, 0, 4, "ADX(" + str.tostring(adxLength) + ")", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 4, str.tostring(adx, "#.0"), text_color = adxCol, text_size = size.small)

    // Row 5: ATR
    table.cell(dash, 0, 5, "ATR(" + str.tostring(atrLength) + ")", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 5, str.tostring(atr, "#.00"), text_color = color.white, text_size = size.small)

    // Row 6: Vol Ratio
    volRatio = volMa > 0 ? volume / volMa : 0.0
    table.cell(dash, 0, 6, "Vol Ratio", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 6, str.tostring(volRatio, "#.0") + "x", text_color = volCol, text_size = size.small)

    // Row 7: BB Width %
    table.cell(dash, 0, 7, "BB Width%", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 7, str.tostring(bbWidthPct, "#.00") + "%", text_color = bbWidthOk ? color.white : color.gray, text_size = size.small)

    // Row 8: Cooldown
    table.cell(dash, 0, 8, "Cooldown", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 8, cooldownOk ? "CLEAR" : str.tostring(activeCooldown - barsSinceExit) + " bars", text_color = cdCol, text_size = size.small)

    // Row 9: Consec Losses
    table.cell(dash, 0, 9, "Consec L", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 9, str.tostring(consecLosses), text_color = consecLosses >= maxConsecLosses ? color.red : color.white, text_size = size.small)

    // Row 10: Risk/Trade
    table.cell(dash, 0, 10, "Risk/Trade", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 10, str.tostring(riskPct, "#.0") + "%", text_color = color.white, text_size = size.small)

    // Row 11: Regime
    table.cell(dash, 0, 11, "Regime", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 11, isRanging ? "RANGE" : "TREND", text_color = adxCol, text_size = size.small)

    // Row 12: Session
    table.cell(dash, 0, 12, "Session", text_color = color.gray, text_size = size.small)
    table.cell(dash, 1, 12, inSession ? "LIVE" : "CLOSED", text_color = sessCol, text_size = size.small)
